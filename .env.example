# MyToneSmith 配置模板
#
# 用法：复制成 .env 再填值
#     cp .env.example .env
#
# .env 已列入 .gitignore，不会被提交。
#
# 优先级：**真实环境变量 > .env > 代码默认值**
# 所以临时覆盖可以直接 export，例如：
#     MYTONE_TEMPERATURE=0 python -m mytone.batch -p "..."
#
# 本项目不读取任何自定义格式的密钥文件（例如 APIkey.txt）——
# 环境变量与 .env 是这里的唯一两种配置方式。

# ---------------------------------------------------------------- 必填
# DeepSeek API 密钥。在 https://platform.deepseek.com 申请
# 把下面这行替换成你自己的密钥（保留 sk- 前缀）
DEEPSEEK_API_KEY=sk-REPLACE_ME

# ---------------------------------------------------------------- 可选
# 接口地址与模型（一般不用改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# LLM 采样温度。默认 0.2。
# 想复现某次运行做排障时设 0。
# MYTONE_TEMPERATURE=0

# HuggingFace 镜像。只有在你所在网络无法直连 huggingface.co 时才需要
# （NIMA 权重与 timm 的 Inception-ResNet-v2 主干从这里下载）。
# HF_ENDPOINT=https://hf-mirror.com
