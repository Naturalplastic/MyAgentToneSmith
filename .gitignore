# ---------------------------------------------------------------- 密钥与本地配置
# .env 里放密钥与机器相关配置；只提交 .env.example 模板
.env
.env.local
.env.*.local

# 旧格式，已弃用（代码不再读取）
APIkey.txt
apiKEY.txt
*.key

# ---------------------------------------------------------------- Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---------------------------------------------------------------- 缓存（体积大，可重建）
.uv-cache/
.pip-cache/
.hf-cache/
.torch-cache/
.tmp/

# ---------------------------------------------------------------- 输入素材
# 批处理输入目录：只保留说明文件，照片与指令 txt 都不提交
input/*
!input/README.md

# ---------------------------------------------------------------- 运行产物
runs/
outbox/

# ---------------------------------------------------------------- 媒体文件：默认一律不放行
#
# 私人照片一旦提交就很难彻底移除（会永久留在 git 历史里），所以这里采取默认拒绝：
# 所有图片扩展名都不提交，且**不设任何例外目录**。
#
# 如果确实需要往仓库里放图（例如文档里的前后对比），请先确认图里没有隐私内容，
# 再用强制添加显式覆盖本规则：
#
#     git add -f docs/对比图.png
#
*.jpg
*.jpeg
*.png
*.webp
*.heic
*.tif
*.tiff
*.bmp
*.gif
# 手机/相机常见的大写扩展名（Linux 下 gitignore 区分大小写）
*.JPG
*.JPEG
*.PNG
*.WEBP
*.HEIC
*.TIF
*.TIFF

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
.DS_Store
